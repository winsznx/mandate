# MANDATE environment. Copy to .env and fill in. Never commit .env.
# Values marked VERIFIED were confirmed against the live chain or a published
# package on 2026-08-17. Values marked BLOCKED need an account you must create.

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- BSC RPC (VERIFIED reachable) --------------------------------------------
# publicnode is primary: it is the only free mainnet endpoint with usable eth_getLogs.
BSC_RPC_URL=https://bsc-rpc.publicnode.com
BSC_FALLBACK_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
BSC_TESTNET_FALLBACK_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# --- Archive RPC (BLOCKED: no free endpoint is reliable) ----------------------
# Public dataseeds retain roughly 64 blocks and 403 on archive requests. Pinned
# historical forks need a paid provider covering BOTH chain 56 and chain 97.
# Without it, trials are limited to head-pinned forks, which at BSC's 0.45s block
# time go stale in under a minute.
BSC_ARCHIVE_RPC_URL=
BSC_TESTNET_ARCHIVE_RPC_URL=

# --- Explorer ----------------------------------------------------------------
# api.bscscan.com V1 is dead. The Etherscan V2 multichain endpoint covers BSC but
# is paid-tier only. Contract verification uses Sourcify, which needs no key.
ETHERSCAN_V2_API_KEY=
SOURCIFY_SERVER_URL=https://sourcify.dev/server

# --- Discovery ---------------------------------------------------------------
# Anonymous access is 30 req/min, 1000 req/day. Cache aggressively.
EIGHTKSCAN_API_BASE=https://api.8004scan.io
EIGHTKSCAN_API_KEY=

# --- Database ----------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Trial runner ------------------------------------------------------------
# The container host running Foundry/Anvil. Not reachable from the public internet.
TRIAL_RUNNER_URL=http://localhost:8787
TRIAL_RUNNER_SECRET=

# --- Deployment --------------------------------------------------------------
# Testnet deployer. Needs ~0.01 BNB, which also unlocks the official faucet
# (it requires a 0.002 BNB mainnet balance).
DEPLOYER_PRIVATE_KEY=

# --- Evidence storage --------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mandate-evidence
R2_PUBLIC_BASE_URL=

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
